# Only needed on first start; the rotated token is then kept in /data/refresh-token.
RING_REFRESH_TOKEN=

TZ=America/New_York
PUID=568
PGID=568

# Comma-separated camera names or ids; empty = all cameras.
CAMERAS=
# motion, ding, or both.
TRIGGERS=motion,ding
CLIP_SECONDS=45
COOLDOWN_SECONDS=15
MAX_CONCURRENT_STREAMS=2

# Optional scheduled continuous recording (wired cameras recommended).
CONTINUOUS_CAMERAS=
CONTINUOUS_SCHEDULE=off
SEGMENT_SECONDS=300

# Delete clips older than N days (0 = keep forever).
RETENTION_DAYS=30

DRY_RUN=false
DEBUG=false
